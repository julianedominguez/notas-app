{
  "name": "notas-app-build",
  "private": true,
  "description": "Arma vendor/editor.js (Tiptap) y copia mammoth. Correr: npm install && npm run build",
  "scripts": {
    "build": "esbuild editor-entry.js --bundle --minify --format=iife --global-name=NotasEditor --target=es2020 --outfile=../vendor/editor.js && cp node_modules/mammoth/mammoth.browser.min.js ../vendor/mammoth.browser.min.js"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "esbuild": "0.28.2",
    "mammoth": "1.13.0"
  }
}
